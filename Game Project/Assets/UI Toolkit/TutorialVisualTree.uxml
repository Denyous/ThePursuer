    <ui:VisualElement name="Panel_EndTutorial" style="flex-grow: 1; background-color: rgba(255, 255, 255, 0); background-image: url(&quot;project://database/Assets/Sprites/Tutorial%20Sprites/Tutorial_bgs/endoftutorial_bg.png?fileID=21300000&amp;guid=567180611e60aba41a504b2f59d595e9&amp;type=3#endoftutorial_bg&quot;); width: 100%; height: 100%; min-height: 100%; max-height: 100%; align-items: center; justify-content: center; display: none;">
