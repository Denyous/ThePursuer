<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/TutorialStyle.uss?fileID=7433441132597879392&amp;guid=3e21ac14a1db738469e02aab106174e6&amp;type=3#TutorialStyle" />
    <ui:VisualElement name="TutorialContainer" class="Container" style="flex-grow: 1; width: 100%; height: 100%;">
        <ui:VisualElement name="ElementContainer" class="ElementContainer" style="flex-grow: 1;">
            <ui:Label tabindex="-1" text="TUTORIAL" parse-escape-sequences="true" display-tooltip-when-elided="true" name="TutorialTitle" class="Header" />
            <ui:VisualElement name="TutorialTemplate" class="TutorialTemplate" style="flex-grow: 1; background-color: rgba(56, 56, 56, 0); background-image: url(&apos;project://database/Assets/Sprites/Tutorial%20Sprites/Tutorial%20template.png?fileID=21300000&amp;guid=eb533b6480054bd47beb0e0e6a645a49&amp;type=3#Tutorial template&apos;); -unity-background-scale-mode: stretch-to-fill;">
                <ui:VisualElement name="InnerTutorialTemplate" class="InnerTutorialTemplate" style="align-self: auto;">
                    <ui:VisualElement name="Image" class="Image" />
                    <ui:VisualElement name="ButtonsPanel" class="ButtonsPanel" style="flex-grow: 1;">
                        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="PrevButton" class="Button BackButtonBG" />
                        <ui:Label tabindex="-1" text="1/9" parse-escape-sequences="true" display-tooltip-when-elided="true" name="TutorialNumber" class="TutorialNum" />
                        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="NextButton" class="Button NextButtonBG" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="BackButton" class="Button BackButton BackButtonBG" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
