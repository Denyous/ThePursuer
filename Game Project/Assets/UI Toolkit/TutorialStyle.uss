.TutorialTemplate {
    width: 100%;
    justify-content: center;
    align-items: center;
    align-self: center;
    height: 95%;
}

.ElementContainer {
    width: 95%;
    height: 90%;
    max-width: 95%;
    max-height: 90%;
}

.Container {
    align-items: center;
    justify-content: center;
    align-self: center;
    flex-grow: 1;
    background-image: url('project://database/Assets/Sprites/Backgrounds/InGame/ArkaplanDegrade.png?fileID=2800000&guid=cf3fe9f1b43e9d74d8f9361d6a0ed364&type=3#ArkaplanDegrade');
    width: 100%;
    height: 100%;
}

.Header {
    -unity-font: url('project://database/Assets/TextMesh%20Pro/Fonts/Audex/Audex.ttf?fileID=12800000&guid=ad39d634ccd4cac4790eb62e8737ce65&type=3#Audex');
    font-size: 80px;
    -unity-font-style: bold;
    color: rgb(250, 143, 0);
    -unity-text-outline-width: 0;
    -unity-font-definition: initial;
    -unity-text-align: upper-center;
}

.Button {
    width: 30%;
    height: 60%;
    background-color: rgba(255, 255, 255, 0);
}

.Image {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    width: 92%;
    height: 80%;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 3%;
}

.InnerTutorialTemplate {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    width: 92%;
    height: 92%;
    justify-content: space-around;
    align-items: center;
    align-self: center;
    flex-grow: 0;
}

.ButtonsPanel {
    flex-direction: row;
    width: 95%;
    height: 10%;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    align-self: auto;
    justify-content: space-between;
    align-items: center;
    min-width: 95%;
    min-height: 10%;
    max-height: 13%;
    max-width: 95px;
}

.TutorialNum {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-font-definition: initial;
    -unity-font: url('project://database/Assets/TextMesh%20Pro/Fonts/SPACE%20EXPLORER.ttf?fileID=12800000&guid=cca25e50c7efb8e42bb6dc1d6ba55c86&type=3#SPACE EXPLORER');
    width: 10%;
    height: 25%;
    max-width: 10%;
    max-height: 25%;
    min-height: 25%;
    min-width: 10%;
    -unity-text-align: middle-center;
}

.BackButton {
    position: relative;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 20%;
    height: 5%;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.BackButtonBG {
    background-image: url('project://database/Assets/Sprites/UI%20Sheets/Ui%20sheets.png?fileID=-1902998606&guid=bd5dde16848754d4d8e3f6500b234abd&type=3#Ui sheets_14');
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.NextButtonBG {
    background-image: url('project://database/Assets/Sprites/UI%20Sheets/Ui%20sheets.png?fileID=-1902998606&guid=bd5dde16848754d4d8e3f6500b234abd&type=3#Ui sheets_14');
    rotate: 180deg;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-left: 0;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-top: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    margin-left: 0;
}
