    m_Metadata:
      m_Items: []
  - m_Id: 91434307584
    m_Localized: "Zbieraj przyspieszacz, aby zwi\u0119kszy\u0107 pr\u0119dko\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 92851982336
    m_Localized: "Zbierz os\u0142on\u0119, aby uzyska\u0107 jednorazow\u0105 ochron\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 93552431104
    m_Localized: "U\u017Cyj flary, aby zniszczy\u0107 rakiety"
    m_Metadata:
      m_Items: []
  - m_Id: 94248685568
    m_Localized: "U\u017Cyj kamikadze, aby rakiety atakowa\u0142y si\u0119 nawzajem"
    m_Metadata:
      m_Items: []
  - m_Id: 94861053952
    m_Localized: "U\u017Cyj lasera, aby szybko niszczy\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 95532142592
    m_Localized: "U\u017Cyj czarnej dziury, aby wci\u0105gn\u0105\u0107 rakiety"
    m_Metadata:
      m_Items: []
