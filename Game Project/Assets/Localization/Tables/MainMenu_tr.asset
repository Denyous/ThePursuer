  m_TableData:
  - m_Id: 58643238912
    m_Localized: "Y\xFCksek Skor: {0} Puan"
    m_Metadata:
      m_Items:
      - rid: 3574364231128317966
  - m_Id: 29606072320
    m_Localized: "Ba\u015Flat"
    m_Metadata:
      m_Items: []
  - m_Id: 32395284480
    m_Localized: "Nas\u0131l Oynan\u0131r?"
    m_Metadata:
      m_Items: []
  - m_Id: 37877239808
    m_Localized: "Eme\u011Fi Ge\xE7enler"
    m_Metadata:
      m_Items: []
  - m_Id: 41526284288
    m_Localized: "\xC7\u0131k\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 46836273152
    m_Localized: Ses
    m_Metadata:
      m_Items: []
  - m_Id: 49650651136
    m_Localized: "M\xFCzik"
    m_Metadata:
      m_Items: []
  - m_Id: 54381826048
    m_Localized: Ses
    m_Metadata:
      m_Items: []
  - m_Id: 61516337152
    m_Localized: "Nas\u0131l Oynan\u0131r?"
    m_Metadata:
      m_Items: []
  - m_Id: 64909529088
    m_Localized: OYUN TASARIMI
    m_Metadata:
      m_Items: []
  - m_Id: 68206252032
    m_Localized: PROGLAMLAMA
    m_Metadata:
      m_Items: []
  - m_Id: 71981125632
    m_Localized: "GRAF\u0130K TASARIMI"
    m_Metadata:
      m_Items: []
  - m_Id: 75793747968
    m_Localized: SES TASARIMI
    m_Metadata:
      m_Items: []
  - m_Id: 80738832384
    m_Localized: "\xC7ubuk ile hareket et."
    m_Metadata:
      m_Items: []
  - m_Id: 84111052800
    m_Localized: "F\xFCzelerden ka\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 88703815680
    m_Localized: "Puanlar\u0131 topla."
    m_Metadata:
      m_Items: []
  - m_Id: 91434307584
    m_Localized: "H\u0131zlanmak i\xE7in g\xFC\xE7lendirme topla."
    m_Metadata:
      m_Items: []
  - m_Id: 92851982336
    m_Localized: "Bir seferli\u011Fine \xF6l\xFCmden ka\xE7mak i\xE7in kalkan g\xFC\xE7lendirmesini
      topla."
    m_Metadata:
      m_Items: []
  - m_Id: 93552431104
    m_Localized: "F\xFCzeleri yok etmek i\xE7in fi\u015Fek g\xFC\xE7lendirmesini
      kullan."
    m_Metadata:
      m_Items: []
  - m_Id: 94248685568
    m_Localized: "Kamikaze g\xFC\xE7lendirmesiyle f\xFCzeleri birbirine \xE7arpt\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 94861053952
    m_Localized: "Lazer ile f\xFCzeleri yok et."
    m_Metadata:
      m_Items: []
  - m_Id: 95532142592
    m_Localized: "Kara delik olu\u015Fturarak f\xFCzeleri i\xE7ine \xE7ek."
    m_Metadata:
      m_Items: []
  - m_Id: 35643345980338176
    m_Localized: "\u0130ptal "
    m_Metadata:
      m_Items: []
  - m_Id: 38597809647702016
    m_Localized: 'Zaman: {0}'
    m_Metadata:
      m_Items:
      - rid: 3574364231128317966
  - m_Id: 40507526577967104
    m_Localized: 'Puan: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40509001710489600
    m_Localized: "Sat\u0131n al"
    m_Metadata:
      m_Items: []
  - m_Id: 40509040432304128
    m_Localized: "Oyunu reklams\u0131z deneyimlemek i\xE7in sat\u0131n al\u0131m
      yapmak ister misiniz?"
    m_Metadata:
      m_Items: []
